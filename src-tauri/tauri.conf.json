{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floppy",
  "version": "0.2.0",
  "identifier": "com.ansiapps.floppy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Floppy",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-2.0-or-later",
    "resources": {
      "resources/dosbox/": "dosbox/",
      "resources/fs-uae/": "fs-uae/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
